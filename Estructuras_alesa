    }

    if (cont == 0)
        cout << "No hay estudiantes registrados.\n";

    archivo.close();
}


void registrarMulta(string archivoMultas)
{
    fstream archivo(archivoMultas, ios::binary | ios::app);
    if (!archivo.is_open())
    {
        cout << "No se pudo abrir el archivo de multas.\n";
        return;
    }

    Multa m;
    m.codigo_multa = generarCodigoMulta();

    cout << "\n=== NUEVA MULTA ===\n";
    cout << "ID Estudiante: ";
    cin >> m.id_estudiante;
    cout << "Dias de retraso: ";
    cin >> m.dias_retraso;
    cout << "Dias de multa: ";
    cin >> m.dias_multa;

    cout << "Fecha de registro de la multa:\n";
    ingresarFechaPrestamo(m.fecha_registro); // reutilizamos funcion de fecha

    archivo.write((char*)&m, sizeof(Multa));
    archivo.close();

    cout << "\nMulta registrada correctamente. Codigo: " << m.codigo_multa << endl;
}

void listadoMultas(string archivoMultas)
{
    ifstream archivo(archivoMultas, ios::binary);
    if (!archivo.is_open())
    {
        cout << "No se pudo abrir el archivo de multas.\n";
        return;
    }

    Multa m;
    int cont = 0;
    cout << "\n=== LISTADO DE MULTAS ===\n\n";
    while (archivo.read((char*)&m, sizeof(Multa)))
    {
        cout << "Multa #" << ++cont << endl;
        cout << "Codigo: " << m.codigo_multa << endl;
        cout << "ID Estudiante: " << m.id_estudiante << endl;
        cout << "Dias retraso: " << m.dias_retraso << endl;
        cout << "Dias multa: " << m.dias_multa << endl;
        cout << "Fecha registro: ";
        mostrarFecha(m.fecha_registro);
        cout << "\n------------------------\n";
    }

    if (cont == 0)
        cout << "No hay multas registradas.\n";

    archivo.close();
}
