struct Categoria
{
    int id_categoria;   // ID único de la categoría
    char nombre[50];    // Nombre del área (ej: Medicina, Física, etc.)
};

struct Estudiante
{
    int id_estudiante;      // ID aleatorio de 6 dígitos
    char nombre[50];        // Nombre del estudiante
    char apellido[50];      // Apellido del estudiante
    char carrera[50];       // Carrera relacionada con la categoría
    bool puede_alquilar;    // true = habilitado, false = inhabilitado
};

struct Multa
{
    int codigo_multa;       // Código aleatorio de 6 dígitos
    int dias_multa;         // Días de multa
    int dias_retraso;       // Días que se retrasó en devolver el libro
    int id_estudiante;      // Relación con el estudiante
    fecha fecha_registro;   // Fecha en que se genera la multa
};

int generarCodigoAleatorio(int digitos = 8)
{
    int min = 1;
    for (int i = 1; i < digitos; i++) min *= 10;
    return min + rand() % (9 * min);
}

void limpiarTexto(char texto[])
{
    for (int i = 0; texto[i] != '\0'; i++)
    {
        unsigned char c = texto[i];
        if (c < 32 || c > 126)
        {
            texto[i] = ' ';
        }
    }
}

void normalizarEntrada(char texto[])
{
    for (int i = 0; texto[i] != '\0'; i++)
    {
        unsigned char c = texto[i];
        if (!((c >= 'A' && c <= 'Z') ||
              (c >= 'a' && c <= 'z') ||
              (c >= '0' && c <= '9') ||
              c == ' '))
        {
            texto[i] = ' ';
        }
    }
}

void ingresarFecha(fecha &f)
{
    cout << "Dia: ";
    cin >> f.dia;
    cout << "Mes: ";
    cin >> f.mes;
    cout << "Anio: ";
    cin >> f.anio;
}

void mostrarFecha(fecha f)
{
    cout << f.dia << "/" << f.mes << "/" << f.anio;
}

// Funciones de Estudiante
void agregarEstudiante(string archivoEstudiantes)
{
    fstream archEstudiantes(archivoEstudiantes, ios::binary | ios::app);
    if (!archEstudiantes.is_open()) return;

    Estudiante e;
    e.ID_estudiante = generarCodigoAleatorio(6);

    cin.ignore();
    cout << "Nombre del estudiante: ";
    cin.getline(e.nombre, 50);
    cout << "Apellido del estudiante: ";
    cin.getline(e.apellido, 50);
    cout << "Carrera: ";
    cin.getline(e.carrera, 50);
    e.habilitado = true;

    archEstudiantes.write((char*)&e, sizeof(Estudiante));
    archEstudiantes.close();
    cout << "Estudiante agregado con ID: " << e.ID_estudiante << endl;
}

void listadoEstudiantes(string archivoEstudiantes)
{
    ifstream archEstudiantes(archivoEstudiantes, ios::binary);
    if (!archEstudiantes.is_open()) return;

    Estudiante e;
    int cont = 0;
    while (archEstudiantes.read((char*)&e, sizeof(Estudiante)))
    {
        limpiarTexto(e.nombre);
        limpiarTexto(e.apellido);
        limpiarTexto(e.carrera);

        cout << "Estudiante #" << ++cont << endl;
        cout << "ID: " << e.ID_estudiante << endl;
        cout << "Nombre: " << e.nombre << " " << e.apellido << endl;
        cout << "Carrera: " << e.carrera << endl;
        cout << "Habilitado para prestamos: " << (e.habilitado ? "Si" : "No") << endl;
        cout << "-----------------------------\n";
    }
    archEstudiantes.close();
}

// Funciones de Categoria
void agregarCategorias(vector<Categoria> &categorias)
{
    const char* nombres[10] = {"Fisica", "Quimica", "Matematica", "Biologia", "Medicina", "Informatica", "Economia", "Historia", "Literatura", "Arte"};
    for (int i = 0; i < 10; i++)
    {
        categorias.push_back({i+1, ""});
        strcpy(categorias[i].nombre, nombres[i]);
    }
}

void listadoCategorias(vector<Categoria> &categorias)
{
    for (int i = 0; i < categorias.size(); i++)
    {
        cout << categorias[i].ID_categoria << " - " << categorias[i].nombre << endl;
    }
}

// Funciones de Multa
void registrarMulta(string archivoMultas, int ID_estudiante, int dias)
{
    fstream archMultas(archivoMultas, ios::binary | ios::app);
    if (!archMultas.is_open()) return;

    Multa m;
    m.codigo_multa = generarCodigoAleatorio(6);
    m.ID_estudiante = ID_estudiante;
    m.dias_retraso = dias;

    cout << "Ingrese fecha de registro del prestamo:\n";
    ingresarFecha(m.fecha_registro);

    archMultas.write((char*)&m, sizeof(Multa));
    archMultas.close();
    cout << "Multa registrada con codigo: " << m.codigo_multa << endl;
}

void listadoMultas(string archivoMultas)
{
    ifstream archMultas(archivoMultas, ios::binary);
    if (!archMultas.is_open()) return;

    Multa m;
    int cont = 0;
    while (archMultas.read((char*)&m, sizeof(Multa)))
    {
        cout << "Multa #" << ++cont << endl;
        cout << "Codigo: " << m.codigo_multa << endl;
        cout << "ID Estudiante: " << m.ID_estudiante << endl;
        cout << "Dias de retraso: " << m.dias_retraso << endl;
        cout << "Fecha registro: ";
        mostrarFecha(m.fecha_registro);
        cout << "\n-----------------------------\n";
    }
    archMultas.close();
